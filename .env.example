# ─────────────────────────────────────────────────────────────
# LAMINAR environment template
# Copy to .env.local (for `npm run dev`) or .env (for Docker) and fill in.
# Everything here is read on the SERVER only. Never prefix secrets with
# NEXT_PUBLIC_, and never commit a real .env file.
# ─────────────────────────────────────────────────────────────

# Market data source:
#   live  - CoinGecko API (default)
#   demo  - bundled sample data, no network needed (UI shows a "Demo data" badge)
MARKET_DATA_MODE=live

# CoinGecko API key. Optional: without it the public endpoint is used,
# which is rate limited (roughly 5-30 calls/min). A free "Demo" key from
# https://www.coingecko.com/en/api raises the limit.
COINGECKO_API_KEY=

# Plan the key belongs to: "demo" (free key) or "pro" (paid key).
COINGECKO_API_PLAN=demo

# Seconds the server caches market responses. Keeps you under rate limits.
MARKET_CACHE_SECONDS=60

# PostgreSQL. Not used by Stage 1 (watchlists and portfolios live in the
# browser until accounts arrive in Stage 2). Used by `docker compose --profile db`.
POSTGRES_USER=laminar
POSTGRES_PASSWORD=change-me
POSTGRES_DB=laminar
DATABASE_URL=postgresql://laminar:change-me@localhost:5432/laminar
